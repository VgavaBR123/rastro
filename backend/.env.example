# Modelo do .env lido pelo docker compose (copie para .env e preencha).
# O .env real NUNCA vai para o git. Valores abaixo sao exemplos, nao segredos.

# --- Banco (servico db) ---------------------------------------------------
DB_NAME=atividades
DB_USER=postgres
# Producao: senha longa e aleatoria (ex.: openssl rand -base64 32).
# So vale na PRIMEIRA subida do volume; depois disso trocar exige ALTER USER.
DB_PASSWORD=troque-esta-senha
# Porta do Postgres no host. Local: 5433. Producao: 127.0.0.1:5433 (so a VPS
# enxerga) ou use deploy/docker-compose.prod.yml para nao publicar nada.
DB_PUBLISH=5433

# --- API (servico api, profile "app") -------------------------------------
# Porta da API no host. Local: 8081. Producao atras do Caddy: 127.0.0.1:8081.
API_PUBLISH=8081
# Dentro do container a API sempre ouve na 8080 (PORT fixo no compose) e
# usa o Postgres (USE_INMEMORY=0, DB_HOST=db, DB_PORT=5432).

# --- E-mail (recuperacao de senha) ---------------------------------------
# console = imprime destinatario e codigo no log (so desenvolvimento).
# smtp    = envia de verdade com as variaveis SMTP_* abaixo.
# 1 quando a API esta atras do Caddy (profile https), que sobrescreve o
# X-Forwarded-For com o IP real. 0 se a API recebe conexoes diretas.
TRUST_PROXY=1

MAILER=console
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario-smtp
SMTP_PASSWORD=troque-esta-senha
# So o endereco (sem "Nome <...>"): vira o remetente da mensagem.
SMTP_FROM=nao-responda@exemplo.com
# true (ou 1) = TLS implicito, porta padrao 465; false = porta padrao 587 (STARTTLS).
# SMTP_PORT vazio usa a porta padrao do modo escolhido.
SMTP_SSL=false

# --- HTTPS (servico caddy, profile "https") -------------------------------
# Dominio com registro A/AAAA apontando para o IP da VPS.
DOMAIN=api.exemplo.com
# Email da conta ACME (avisos de expiracao do Let's Encrypt).
ACME_EMAIL=voce@exemplo.com

# --- Atalhos do docker compose (opcional, so na VPS) -----------------------
# Descomente para que `docker compose up -d`, `logs`, `ps` ja usem o override
# de producao e os profiles da API e do Caddy.
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.prod.yml
# COMPOSE_PROFILES=app,https
